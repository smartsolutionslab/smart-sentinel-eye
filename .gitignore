# .NET
bin/
obj/
*.user
*.suo
.vs/
*.pdb
*.dll
*.exe
project.lock.json
project.fragment.lock.json
artifacts/
TestResults/
coverage/
*.coverage
*.coveragexml

# Node / Vite
node_modules/
.pnp.*
.yarn/
dist/
dist-ssr/
.vite/
*.local

# IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# OS
.DS_Store
Thumbs.db

# Logs and dumps
*.log
*.dmp
logs/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.pfx
*.key

# Helm output (regenerated)
deploy/helm/generated/

# Aspire / dotnet user secrets and local manifests
*.runtimeconfig.dev.json
aspire-dashboard-storage/

# Agent state (Spec-Kit init warns about this)
.claude/settings.local.json
.claude/.cache/
# Per-agent git worktrees created by the isolation:worktree workflow (ADR-0109);
# local runtime state, never committed.
.claude/worktrees/

# Misc
*.tmp
*.bak

# Playwright (ADR-0108) — e2e artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# AppHost resource-status report (#2268, StackStatusFile=) — written at boot,
# read by scripts/wait-for-e2e-stack.sh, never committed.
/stack-status.tsv

# Local-only: a BOM-prefixed copy of coverage-check.ps1, because Windows
# PowerShell 5.1 mis-decodes the script's UTF-8 characters without one.
scripts/coverage-check.bom.ps1

# tokens.build.test.ts (spec 256, issue #2332) writes a virtual probe sheet
# into the source tree at runtime; a crashed run can leave it behind for
# git/format:check/DesignTokenLayerTests to trip over.
**/src/styles/__probe__.css
