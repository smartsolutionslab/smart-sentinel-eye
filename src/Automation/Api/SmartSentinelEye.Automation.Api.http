@SmartSentinelEye.Automation.Api_HostAddress = http://localhost:5143

GET {{SmartSentinelEye.Automation.Api_HostAddress}}/weatherforecast/
Accept: application/json

###

# Spec 296 US1 — a SwitchWallScene rule (needs a bearer token with sse.rules.write)

POST {{SmartSentinelEye.Automation.Api_HostAddress}}/rules
Content-Type: application/json
Idempotency-Key: example-create-key-1

{
  "name": "line-3-fault",
  "triggerSource": "manual",
  "triggerKind": "line-stop",
  "predicate": "$.payload.line == 3",
  "actionType": "SwitchWallScene",
  "wallIdentifier": "00000000-0000-0000-0000-000000000001",
  "sceneTarget": "Layout",
  "targetLayoutIdentifier": "00000000-0000-0000-0000-000000000002"
}

