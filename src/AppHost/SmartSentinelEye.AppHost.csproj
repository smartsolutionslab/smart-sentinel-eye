<Project Sdk="Aspire.AppHost.Sdk/13.5.3">

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.NodeJs" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Aspire.Hosting.Keycloak" />
    <PackageReference Include="CommunityToolkit.Aspire.Hosting.Minio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CameraCatalog\Api\SmartSentinelEye.CameraCatalog.Api.csproj" />
    <ProjectReference Include="..\StreamDistribution\Api\SmartSentinelEye.StreamDistribution.Api.csproj" />
    <ProjectReference Include="..\LayoutComposition\Api\SmartSentinelEye.LayoutComposition.Api.csproj" />
    <ProjectReference Include="..\SystemVariables\Api\SmartSentinelEye.SystemVariables.Api.csproj" />
    <ProjectReference Include="..\EventIngestion\Api\SmartSentinelEye.EventIngestion.Api.csproj" />
    <ProjectReference Include="..\OverlayDesigner\Api\SmartSentinelEye.OverlayDesigner.Api.csproj" />
    <ProjectReference Include="..\Automation\Api\SmartSentinelEye.Automation.Api.csproj" />
    <ProjectReference Include="..\Identity\Api\SmartSentinelEye.Identity.Api.csproj" />
    <ProjectReference Include="..\AuditObservability\Api\SmartSentinelEye.AuditObservability.Api.csproj" />
    <ProjectReference Include="..\MigrationRunner\SmartSentinelEye.MigrationRunner.csproj" />
    <ProjectReference Include="..\ScenarioSimulator\SmartSentinelEye.ScenarioSimulator.csproj" />
    <ProjectReference Include="..\ApiGateway\SmartSentinelEye.ApiGateway.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>b82c8f51-95b9-4b1a-832a-a8744b2112a9</UserSecretsId>

    <!-- Aspire 13.5 reports ASPIRE010 whenever AspireUseCliBundle is left at
         its default of false. That opt-in is a preview feature: it sources DCP
         and the dashboard from the installed Aspire CLI bundle instead of
         NuGet, so `dotnet build` would start depending on an `aspire` on PATH
         (or a dnx fallback), and CI installs neither. We deliberately keep the
         NuGet-restored orchestration dependencies, which is the case the SDK
         docs say to suppress for. Revisit when the opt-in leaves preview and
         becomes the SDK default. -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

</Project>
