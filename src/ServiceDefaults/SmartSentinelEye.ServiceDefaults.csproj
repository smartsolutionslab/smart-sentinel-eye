<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- ADR-0141: NRT exception, not yet converted. -->
    <Nullable>disable</Nullable>
    <IsAspireSharedProject>true</IsAspireSharedProject>
    <!-- ServiceDefaults extension methods live in Microsoft.Extensions.Hosting by convention so
         consumers don't need an explicit using directive. Suppress the folder-structure check. -->
    <NoWarn>$(NoWarn);IDE0130</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared.CQRS\SmartSentinelEye.Shared.CQRS.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />

    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />
    <PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />

    <!-- Auth client (ADR-0007 + ADR-0008 + ADR-0023). Plain JwtBearer; no Aspire.Keycloak.Authentication needed. -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />

    <!-- Aggregate-version interceptor + concurrency-conflict handler (ADR-0113).
         Referenced explicitly rather than relied on transitively via
         WolverineFx.EntityFrameworkCore. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />

    <!-- NpgsqlConnectionStringBuilder for the pool cap (ADR-0125). Explicit for
         the same reason as EF Core above: it arrives transitively via
         WolverineFx.Postgresql, and a transitive reference is one dependency
         change away from disappearing. -->
    <PackageReference Include="Npgsql" />

    <!-- Wolverine defaults (ADR-0042 + ADR-0057 + ADR-0088). -->
    <PackageReference Include="WolverineFx" />
    <PackageReference Include="WolverineFx.EntityFrameworkCore" />
    <PackageReference Include="WolverineFx.Postgresql" />
    <PackageReference Include="WolverineFx.RabbitMQ" />
    <PackageReference Include="WolverineFx.RuntimeCompilation" />
  </ItemGroup>

</Project>
