<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Domain\SmartSentinelEye.AuditObservability.Domain.csproj" />
    <ProjectReference Include="..\..\Shared.Kernel\SmartSentinelEye.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\Shared.CQRS\SmartSentinelEye.Shared.CQRS.csproj" />
    <ProjectReference Include="..\..\Shared.Contracts\SmartSentinelEye.Shared.Contracts.csproj" />
  </ItemGroup>

  <!-- ADR-0047: handlers write Success(...) / Failure(...) without repeating
       both type arguments. Imported globally so every handler reads the same. -->
  <ItemGroup>
    <Using Include="SmartSentinelEye.Shared.Kernel.Result" Static="true" />
  </ItemGroup>

  <!-- Spec 226 FR-007: V1ResourceMap.Conventions.HandTweaks and
       NamespaceToResource are internal. The reachability guard derives its
       convention-mapped set from them directly, rather than hard-coding the
       hand-tweak names, so it stays correct when a hand-tweak is added or
       removed. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>SmartSentinelEye.AuditObservability.Application.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
