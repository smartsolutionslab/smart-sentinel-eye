<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- ADR-0141 (amending ADR-0048): NRT enabled; Option<T> retained for
         domain absences and repository lookups. One default, no overrides. -->
    <Nullable>enable</Nullable>

    <!-- ADR-0034: Roslyn analyzers enforced; warnings are errors in Release. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>

    <!-- Reproducible builds. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Not a NuGet package by default; opt in per project as needed. -->
    <IsPackable>false</IsPackable>

    <!-- Common shape across the solution. -->
    <RootNamespace>SmartSentinelEye$(MSBuildProjectName.Replace('SmartSentinelEye', ''))</RootNamespace>

    <!-- Test projects identified by path. -->
    <IsTestProject Condition="$(MSBuildProjectDirectory.Contains('\tests\')) Or $(MSBuildProjectDirectory.Contains('/tests/'))">true</IsTestProject>
    <IsTestProject Condition="'$(IsTestProject)' == ''">false</IsTestProject>
  </PropertyGroup>

  <!-- ADR-0084: the SonarAnalyzer package that implements the code-metric
       rules. This ItemGroup is the PackageReference block — it configures no
       severity and no threshold; those live in .editorconfig and
       SonarLint.xml (below and in the AdditionalFiles ItemGroup further
       down). -->
  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- ADR-0084: the five code-metric thresholds. SonarAnalyzer reads rule
       parameters from an AdditionalFile named exactly SonarLint.xml; the
       severities live in .editorconfig, and neither input works without the
       other. Non-test projects only — ADR-0084 exempts tests, and that
       exemption is ALSO spelled out in .editorconfig, because editorconfig
       severity outranks the NoWarn below. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)SonarLint.xml" />
  </ItemGroup>

  <!-- ADR-0049: ConfigureAwait is banned in application code (ASP.NET Core has
       no SynchronizationContext, so it is behaviour-preserving noise). The ban
       list applies only to production app projects. Shared.* libraries are
       exempt — they may legitimately ConfigureAwait if externalized as
       standalone packages — and test projects are out of scope. -->
  <ItemGroup Condition="'$(IsTestProject)' != 'true' And !$(MSBuildProjectName.StartsWith('SmartSentinelEye.Shared'))">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" />
  </ItemGroup>

  <!-- ADR-0139: every argument precondition uses Ensure.That, not the BCL
       ThrowIf* helpers. This ban binds MORE broadly than the ConfigureAwait one
       above: Shared.* and test projects are covered, because Ensure lives in
       Shared.Kernel and there is no standalone-packaging argument for guards.
       AppHost is the sole project exemption; it does not reference
       Shared.Kernel by design, so the replacement is unavailable there.
       Generated migrations are exempted by path in .editorconfig instead,
       because they share a project with infrastructure code that must stay
       covered. Both lists must be named BannedSymbols.txt: the analyzer
       matches additional files by that prefix, and multi-file support has
       regressed once (roslyn-analyzers#5622). The directory is what
       distinguishes them. -->
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'SmartSentinelEye.AppHost'">
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)build\guards\BannedSymbols.txt" />
  </ItemGroup>

  <!-- Production code: unrelated repo-wide suppressions, plus the ADR-0084
       Release carve-out below. This PropertyGroup sets no metric limit itself
       — the five thresholds live in SonarLint.xml, the severities in
       .editorconfig. -->
  <PropertyGroup Condition="'$(IsTestProject)' != 'true'">
    <!-- ADR-0084 (as amended 2026-09-17): the five metric limits are ADVISORY.
         TreatWarningsAsErrors is on in Release above, and CI builds Release, so
         severity `warning` alone would turn the recorded baseline into that many
         build ERRORS on the first push. This carve-out is how "warning, not
         error" is expressed under ADR-0034's Release policy.

         It is PERMANENT, not a migration aid. Deleting it does not tighten the
         limits; it breaks the build. If these limits are ever to become blocking,
         that is an ADR-0084 amendment plus a cleanup of the baseline, not the
         removal of this line. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);S104;S138;S107;S1541;S134</WarningsNotAsErrors>

    <!--
      S104 file too long, S138 method too long, S107 too many params, S1541 cyclomatic complexity, S134 nesting depth.

      Repo-wide design-justified suppressions (each has a written rationale):
        CA1716 — types/namespaces "Option", "Result", "Shared.*", and similar
                 conflict with reserved keywords in F#/VB. We use these names
                 by convention (ADR-0047 Result, ADR-0048 Option, ADR-0027
                 Shared.* layout). Suppressed solution-wide.
        CA1000 — static factory methods on generic types (Option<T>.Some,
                 Result<T,E>.Success, …) are the canonical shape for the
                 value-record pattern; alternatives (helper class) hurt
                 call-site clarity.
        S2326  — phantom type parameters on ICommand<TResult> / IQuery<TResult>
                 enable type-safe handler dispatch (ICommandHandler<TCmd,TR> where
                 TCmd : ICommand<TR>); the unused-type-parameter check is
                 incorrect for this pattern (ADR-0042 + ADR-0057).
        CA1711 — our Application-layer event handler types end in
                 "DomainEventHandler" / "IntegrationEventConsumer" by convention
                 (ADR-0093). The framework warning targets WinForms-era
                 conflicts that don't apply.
        CA1848 — LoggerMessage source generators are a hot-path optimisation
                 that adds boilerplate without measurable benefit for our
                 command-path log volume. Revisit if a leg of the latency
                 budget (ADR-0015) attributes time to logging.
        CA1873 — Lazy logger-argument evaluation matters for expensive
                 ToString calls. Our value objects have cheap ToString
                 implementations; the warning is noise here.
    -->
    <NoWarn>$(NoWarn);CA1716;CA1000;S2326;CA1711;CA1848;CA1873</NoWarn>
  </PropertyGroup>

  <!-- Tests: for ADR-0084's five metric rules, this NoWarn is belt-and-braces,
       not the decision — .editorconfig's [tests/**.cs] severity = none is the
       input that actually wins (editorconfig severity outranks NoWarn), so
       treat that section as authoritative and this list as the second line of
       defence. S2699/CA1707/CA1716 are unrelated to ADR-0084 and this NoWarn
       is still what suppresses them; loud test methods are valuable, hence
       CA1707's naming-convention relaxation. -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <NoWarn>$(NoWarn);S104;S138;S107;S1541;S134;S2699;CA1707;CA1716</NoWarn>
  </PropertyGroup>

</Project>
